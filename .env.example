# Public
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com     # real production domain, no trailing slash
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_APP_STORE_URL=                           # leave empty until app is published
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_GA4_ID=                                  # add only after a cookie-consent banner exists
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=                # Search Console "HTML tag" content value
# Supabase (server secrets must never be exposed to the client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                           # server only: needed for mobile-number login and webhooks
DATABASE_URL=
# Payments (provider TBD after merchant/marketplace review)
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# OTP / email / identity verification
OTP_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
IDV_PROVIDER_API_KEY=

# ---- Added in Phase 2-4 ----
NEXT_PUBLIC_LEGAL_ENTITY_NAME=                       # real registered business name (used in legal pages/footer)
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=                        # official URLs only; empty = link hidden
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
GST_RATE_BPS=1800                                    # confirm with your CA
PLATFORM_COMMISSION_BPS=                             # e.g. 2000 = 20%; empty = shown as "to be configured"
